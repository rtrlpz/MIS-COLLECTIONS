# Ignore Power BI files (Dashboards)
*.pbix

# Ignore Power BI model files (generated, STALE)
dashboards/models/

# Ignore DAX-derived transient outputs in dashboards
dashboards/dax/measures.tsv

# Ignore personal interview prep folder
interview_prep/
docs/interviews/

# Ignore private/real-world reference data (NEVER commit)
docs/unused/
docs/*.docx
*.docx
*.pdf

# Ignore Excel outputs
reports/output/*.xlsx
reports/output/*.csv
reports/templates/*.xlsx
reports/templates/*.csv

# Ignore database data/credentials
pgdata/
database/.env
database/data/
.env

# Ignore IDE files
.idea/

# Ignore Power BI temporary/model files
*.SemanticModel/
*.Report/

# Ignore generated logs + raw data (never edit generated CSVs)
data_sources/logs/
data_sources/raw/
data_sources/raw_test*/
etl/logs
etl/errors/

# Ignore Python cache
__pycache__/
*.pyc

# Ignore pytest cache
.pytest_cache

# Opencode temporary files
*.tmp
.opencode/

# Local-only dashboards output (PBIX are *.pbix; keep models/ stale exports local)
dashboards/pbix/

# Jupyter checkpoints
**/.ipynb_checkpoints/

# .vscode config
.vscode/